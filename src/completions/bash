_feature_branch_complete() {
  local word="${COMP_WORDS[COMP_CWORD]}"
  mapfile -t COMPREPLY < <(feature complete --type branch "$word")
}

_feature_remote_complete() {
  local word="${COMP_WORDS[COMP_CWORD]}"
  mapfile -t COMPREPLY < <(feature complete --type remote "$word")
}

_feature_rev_complete() {
  local word="${COMP_WORDS[COMP_CWORD]}"
  mapfile -t COMPREPLY < <(feature complete --type rev "$word")
}

_feature_file_complete() {
  local word="${COMP_WORDS[COMP_CWORD]}"

  # save old field sep
  local oldifs
  if [ -n "${IFS+x}" ]; then
    oldifs="$IFS"
  fi

  # set field sep to newlines only
  IFS=$'\n'

  # generate file completions
  COMPREPLY=( $(compgen -f "$word") )

  # restore old field sep
  if [ -n "${oldifs+x}" ]; then
    IFS="$oldifs"
  fi

  # set filenames option in bash >= 4
  if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
    compopt -o filenames
  fi
}

_feature_dir_complete() {
  COMPREPLY=()
  if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
    compopt -o plusdirs
  fi
}

_feature() {
  local bin="$1"
  local cur
  if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
    cur="$2"
  else
    cur="${COMP_WORDS[COMP_CWORD]}"
  fi

  local prev="$3"
  local cmd=""

  # find subcommand
  local word
  for word in "${COMP_WORDS[@]:0:COMP_CWORD}"; do
    # match last seen command and current word
    case "$cmd,$word" in
      ",$bin")
        cmd="feature"
        ;;

      feature,base)
        cmd="base"
        ;;

      feature,check)
        cmd="check"
        ;;

      feature,commit)
        cmd="commit"
        ;;

      feature,push)
        cmd="push"
        ;;

      feature,show)
        cmd="show"
        ;;

      feature,start)
        cmd="start"
        ;;

      feature,update)
        cmd="update"
        ;;

      *)
        ;;
    esac
  done

  # generate completions depending on the cmd found
  case "$cmd" in
    feature)
      local opts="--help --config --git-dir --work-tree --wt base check commit \
        complete completions config graph list log prune push show start \
        status sync update"

      # if cur is a flag or first word after bin
      if [[ $cur == -* || ${COMP_CWORD} -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
        return 0
      fi

      case "$prev" in
        --config)
          _feature_file_complete
          return 0
          ;;

        --git-dir | --work-tree | --wt)
          _feature_dir_complete
          return 0
          ;;

        *)
          COMPREPLY=()
          return 0
          ;;
      esac
      ;;

    base | check)
      if [[ $cur != -* ]]; then
        _feature_branch_complete
        return 0
      fi
      ;;

    commit)
      if [[ $cur != -* ]]; then
        _feature_rev_complete
        return 0
      fi
      ;;

    push)
      if [[ $cur != -* ]]; then
        case "$prev" in
          --remote)
            _feature_remote_complete
            return 0
            ;;
          --upstream | --branch)
            _feature_branch_complete
            return 0
            ;;
        esac
      fi
      ;;

    show)
      if [[ $cur != -* ]]; then
        _feature_rev_complete
        return 0
      fi
      ;;

    start)
      if [[ $cur != -* ]]; then
        case "$prev" in
          --from)
            _feature_branch_complete
            return 0
            ;;
        esac
      fi
      ;;

    update)
      if [[ $cur != -* ]]; then
        _feature_branch_complete
        return 0
      fi
      ;;
  esac
}

if [[ "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -ge 4 || "${BASH_VERSINFO[0]}" -gt 4 ]]; then
  complete -F _feature -o nosort -o bashdefault -o default feature
else
  complete -F _feature -o bashdefault -o default feature
fi
