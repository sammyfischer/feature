# Generates completions for a branch name
#
# Params
# $0 - (required) the prefix to match
# $1 - (optional) the git dir
# $2 - (optional) the work tree
#
# Returns
# Prints a space-separated list of matching branches
_feature_compgen_branches() {
  local word="$1"
  local git_dir="$2"
  local work_tree="$3"

  local -a args=()
  if [[ -n "$git_dir" ]]; then
    args+=("--git-dir" "$git_dir")
  fi
  if [[ -n "$work_tree" ]]; then
    args+=("--work-tree" "$work_tree")
  fi

  args+=("complete" "--type" "branch" "$word")

  printf "%s" "$(feature "${args[@]}")"
}

# Generates completions for a remote name
#
# Params
# $0 - (required) the prefix to match
# $1 - (optional) the git dir
# $2 - (optional) the work tree
#
# Returns
# Prints a space-separated list of matching remotes
_feature_compgen_remotes() {
  local word="$1"
  local git_dir="$2"
  local work_tree="$3"

  local -a args=()
  if [[ -n "$git_dir" ]]; then
    args+=("--git-dir" "$git_dir")
  fi
  if [[ -n "$work_tree" ]]; then
    args+=("--work-tree" "$work_tree")
  fi

  args+=("complete" "--type" "remote" "$word")

  printf "%s" "$(feature "${args[@]}")"
}

# Generates completions for a revision name
#
# Params
# $0 - (required) the prefix to match
# $1 - (optional) the git dir
# $2 - (optional) the work tree
#
# Returns
# Prints a space-separated list of matching revisions
_feature_compgen_revisions() {
  local word="$1"
  local git_dir="$2"
  local work_tree="$3"

  local -a args=()
  if [[ -n "$git_dir" ]]; then
    args+=("--git-dir" "$git_dir")
  fi
  if [[ -n "$work_tree" ]]; then
    args+=("--work-tree" "$work_tree")
  fi

  args+=("complete" "--type" "rev" "$word")

  printf "%s" "$(feature "${args[@]}")"
}

_feature() {
  local bin="$1"
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local prev="$3"
  if [[ "$prev" == "=" ]]; then
    prev="${COMP_WORDS[COMP_CWORD-2]}"
  fi
  local cmd=""
  local git_dir=""
  local work_tree=""

  # find subcommand
  local word
  for word in "${COMP_WORDS[@]:0:COMP_CWORD}"; do
    # match last seen command and current word
    case "$cmd,$word" in
      ",$bin")
        cmd="feature"
        ;;

      "feature,--git-dir")
        cmd="--git-dir"
        ;;

      "--git-dir,=")
        ;;

      "--git-dir,"*)
        git_dir="$word"
        cmd="feature"
        ;;

      "feature,--wt" | "feature,--work-tree")
        cmd="--work-tree"
        ;;

      "--work-tree,=")
        ;;

      "--work-tree,"*)
        work_tree="$word"
        cmd="feature"
        ;;

      feature,base)
        cmd="base"
        ;;

      feature,check)
        cmd="check"
        ;;

      feature,commit)
        cmd="commit"
        ;;

      feature,completions)
        cmd="completions"
        ;;

      feature,config)
        cmd="config"
        ;;

      config,create)
        cmd="config_create"
        ;;

      config,get)
        cmd="config_get"
        ;;

      config,schema)
        cmd="config_schema"
        ;;

      feature,end)
        cmd="end"
        ;;

      feature,graph)
        cmd="graph"
        ;;

      feature,list | feature,ls)
        cmd="list"
        ;;

      feature,log)
        cmd="log"
        ;;

      feature,prune)
        cmd="prune"
        ;;

      feature,push)
        cmd="push"
        ;;

      feature,show)
        cmd="show"
        ;;

      feature,start)
        cmd="start"
        ;;

      feature,status | feature,st)
        cmd="status"
        ;;

      feature,sync)
        cmd="sync"
        ;;

      feature,update)
        cmd="update"
        ;;

      *)
        ;;
    esac
  done

  # generate completions depending on the cmd found
  case "$cmd" in
    feature)
      local opts="--help -V --version --config --git-dir --work-tree --wt base check commit \
        completions config graph list ls log prune push show start status st \
        sync update"
      case "$prev" in
        --config)
          COMPREPLY=( $(IFS='\n' compgen -f "${cur#=}") )
          compopt -o filenames
          ;;

        --git-dir | --work-tree | --wt)
          COMPREPLY=( $(IFS='\n' compgen -d "${cur#=}") )
          compopt -o dirnames
          ;;

        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
          ;;
      esac
      ;;

    base)
      local opts="--help --branch"
      case "$prev" in
        --branch)
          COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          ;;
        *)
          case "$cur" in
            -*)
              COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
              ;;
            *)
              COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          esac
      esac
      ;;

    check)
      local opts="--help --base"
      case "$prev" in
        --base)
          COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          ;;
        *)
          case "$cur" in
            -*)
              COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
              ;;
            *)
              COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          esac
      esac
      ;;

    commit)
      local opts="--help --amend --no-verify --to"
      case "$prev" in
        --to)
          COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          ;;
        *)
          case "$cur" in
            "" | -*)
              COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
              ;;
            *)
              COMPREPLY=()
              ;;
          esac
          ;;
      esac
      ;;

    completions)
      local opts="--help bash elvish fish powershell zsh"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur"))
      ;;

    config)
      local opts="--help --which -g create get schema"
      case "$prev" in
        --which)
          COMPREPLY=( $(compgen -W "project local user global" -- "$cur") )
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
          ;;
      esac
      ;;

    config_create | config_schema)
      local opts="--help"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur"))
      ;;

    config_get)
      local opts="--help"
      local keys="default_remote protect format.branch_sep format.branch"
      case "$cur" in
        -*)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur"))
          ;;
        *)
          COMPREPLY=( $(compgen -W "$keys" -- "$cur"))
          ;;
      esac
      ;;

    end)
      local opts="--help -r --remote -f --force --base"
      case "$prev" in
        --base)
          COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          ;;
        -r | --remote)
          COMPREPLY=( $(compgen -W "true false" -- "${cur#=}") )
          ;;
        *)
          case "$cur" in
            "" | -*)
              COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
              ;;
            *)
              COMPREPLY=()
              ;;
          esac
          ;;
      esac
      ;;

    graph | log)
      local opts="--help --format --fmt"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
      ;;

    list)
      local opts="--help -H --no-hash -U --no-upstream -B --no-base"
      case "$prev" in
        -H | --no-hash | -U | --no-upstream | -B | --no-base)
          COMPREPLY=( $(compgen -W "true false" -- "${cur#=}") )
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
          ;;
      esac
      ;;

    prune)
      local opts="--help --dry-run"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
      ;;

    push)
      local opts="--help -f --force -r --remote -u --upstream"
      case "$prev" in
        -r | --remote)
          COMPREPLY=( $(_feature_compgen_remotes "$cur" "$git_dir" "$work_tree") )
          ;;
        -u | --upstream)
          COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          ;;
        *)
          case "$cur" in
            -*)
              COMPREPLY=( $(compgen -W "$opts", -- "$cur") )
              ;;
            *)
              COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
              ;;
          esac
          ;;
      esac
      ;;

    show)
      local opts="--help -S --no-summary -P --no-patch -m --message --paging"
      case "$prev" in
        -m | --message)
          COMPREPLY=( $(compgen -W "none subject full" -- "$cur") )
          ;;
        --paging)
          COMPREPLY=( $(compgen -W "auto always never" -- "$cur") )
          ;;
        -S | --no-summary | -P | --no-patch)
          COMPREPLY=( $(compgen -W "true false" -- "${cur#=}") )
          ;;
        *)
          case "$cur" in
            -*)
              COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
              ;;
            *)
              COMPREPLY=( $(_feature_compgen_revisions "$cur" "$git_dir" "$work_tree") )
              ;;
          esac
          ;;
      esac
      ;;

    start)
      local opts="--help --dry-run --sep --format --fmt --from -s --stay"
      case "$prev" in
        --from)
          COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          ;;
        *)
          case "$cur" in
            "" | -*)
              COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
              ;;
            *)
              COMPREPLY=()
              ;;
          esac
          ;;
      esac
      ;;

    status)
      local opts="--help -u --no-untracked"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
      ;;

    sync)
      local opts="--help --dry-run -P --no-prune"
      case "$prev" in
        -P | --no-prune)
          COMPREPLY=( $(compgen -W "true false" -- "${cur#=}") )
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
          ;;
      esac
      ;;

    update)
      local opts="--help --dry-run -c --continue -a --abort"
      case "$cur" in
        -*)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
          ;;
        *)
          COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          ;;
      esac
      ;;
  esac
}

complete -F _feature -o nosort -o bashdefault -o default feature
