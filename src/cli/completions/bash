# Generates completions for a project name
#
# Params
# $0 - (required) the prefix to match
# $1 - (optional) the project-level config file
#
# Returns
# Prints a space-separated list of matching revisions
_feature_compgen_projects() {
  local word="$1"
  local config="$2"

  local -a args=()
  if [[ -n "$config" ]]; then
    args+=("--config" "$git_dir")
  fi

  args+=("complete" "--type" "project" "$word")

  printf "%s" "$(feature "${args[@]}")"
}

_feature() {
  local bin="$1"
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local prev="$3"
  if [[ "$prev" == "=" ]]; then
    prev="${COMP_WORDS[COMP_CWORD-2]}"
  fi
  local cmd=""
  local config=""
  local git_dir=""
  local work_tree=""

  # find subcommand
  local word
  for word in "${COMP_WORDS[@]:0:COMP_CWORD}"; do
    # match last seen command and current word
    case "$cmd,$word" in
      ",$bin")
        cmd="feature"
        ;;

      "feature,--config")
        cmd="--config"
        ;;
      "--config,=")
        ;;
      "--config,"*)
        config="$word"
        cmd="feature"
        ;;

      "feature,--git-dir")
        cmd="--git-dir"
        ;;
      "--git-dir,=")
        ;;
      "--git-dir,"*)
        git_dir="$word"
        cmd="feature"
        ;;

      "feature,--wt" | "feature,--work-tree")
        cmd="--work-tree"
        ;;
      "--work-tree,=")
        ;;
      "--work-tree,"*)
        work_tree="$word"
        cmd="feature"
        ;;

      feature,base)
        cmd="base"
        ;;

      feature,branches)
        cmd="branches"
        ;;

      feature,check)
        cmd="check"
        ;;

      feature,commit)
        cmd="commit"
        ;;

      feature,completions)
        cmd="completions"
        ;;

      feature,config)
        cmd="config"
        ;;
      config,create)
        cmd="config_create"
        ;;
      config,get)
        cmd="config_get"
        ;;
      config,schema)
        cmd="config_schema"
        ;;

      feature,end)
        cmd="end"
        ;;

      feature,protect | feature,prot)
        cmd="protect"
        ;;

      feature,project | feature,proj)
        cmd="project"
        ;;
      project,add)
        cmd="project_add"
        ;;
      project,rm | project,remove)
        cmd="project_rm"
        ;;
      project,ls | project,list)
        cmd="project_ls"
        ;;
      project,each)
        cmd="project_each"
        ;;

      feature,prune)
        cmd="prune"
        ;;

      feature,push)
        cmd="push"
        ;;

      feature,show)
        cmd="show"
        ;;

      feature,start | feature,branch)
        cmd="start"
        ;;

      feature,status | feature,st)
        cmd="status"
        ;;

      feature,sync)
        cmd="sync"
        ;;

      feature,tag)
        cmd="tag"
        ;;

      feature,tags)
        cmd="tags"
        ;;

      feature,update)
        cmd="update"
        ;;

      feature,version_log | feature,verlog)
        cmd="version_log"
        ;;

      feature,wip | feature,stash)
        cmd="wip"
        ;;
      wip,drop | wip,rm)
        cmd="wip_drop"
        ;;
      wip,list | wip,ls)
        cmd="wip_list"
        ;;
      wip,pop | wip,apply)
        cmd="wip_pop"
        ;;
      wip,push | wip,save | wip,add)
        cmd="wip_push"
        ;;
      wip,show)
        cmd="wip_show"
        ;;

      *)
        ;;
    esac
  done

  # generate completions depending on the cmd found
  case "$cmd" in
    feature)
      local opts="-h --help -V --version --config --git-dir --work-tree --wt \
        base branches check commit completions config end protect prot project \
        proj prune push show start status st sync tag tags update version-log \
        verlog wip"
      case "$prev" in
        --config)
          COMPREPLY=( $(IFS='\n' compgen -f "${cur#=}") )
          compopt -o filenames
          ;;

        --git-dir | --work-tree | --wt)
          COMPREPLY=( $(IFS='\n' compgen -d "${cur#=}") )
          compopt -o dirnames
          ;;

        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
          ;;
      esac
      ;;

    base)
      local opts="-h --help --branch"
      case "$prev" in
        --branch)
          COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
      esac
      ;;

    branches)
      local opts="-h --help -P --no-projects -M --no-modules"
      case "$prev" in
        -P | --no-projects | -M | --no-modules)
          COMPREPLY=( $(compgen -W "true false" -- "${cur#=}") )
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          ;;
      esac
      ;;

    check)
      local opts="-h --help --base"
      case "$prev" in
        --base)
          COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
      esac
      ;;

    commit)
      local opts="-h --help --amend --no-verify --to"
      case "$prev" in
        --to)
          COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
          ;;
      esac
      ;;

    completions)
      local opts="-h --help bash elvish fish powershell zsh"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur"))
      ;;

    config)
      local opts="-h --help --which -g --global create get schema"
      case "$prev" in
        --which)
          COMPREPLY=( $(compgen -W "local global" -- "$cur") )
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
          ;;
      esac
      ;;

    config_create | config_schema)
      local opts="-h --help"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur"))
      ;;

    config_get)
      local opts="-h --help"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
      ;;

    end)
      local opts="-h --help -r --remote -f --force --base"
      case "$prev" in
        --base)
          COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          ;;
        -r | --remote)
          COMPREPLY=( $(compgen -W "true false" -- "${cur#=}") )
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          ;;
      esac
      ;;

    protect)
      local opts="-h --help -u --unset"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur") $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
      ;;

    project)
      local opts="-h --help add rm remove ls list each"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
      ;;

    project_add)
      local opts="-h --help --repo --path"
      case "$prev" in
        --repo)
          # default comps
          ;;
        --path)
          COMPREPLY=( $(IFS='\n' compgen -d "${cur#=}") )
          compopt -o dirnames
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
          ;;
      esac
      ;;

    project_rm)
      local opts="-h --help"
      local projects="$(_feature_compgen_projects "$cur" "$config")"
      COMPREPLY=( $(compgen -W "$opts $projects" -- "$cur") )
      ;;

    project_ls)
      local opts="-h --help"
      COMPREPLY=("$opts")
      ;;

    project_each)
      local opts="-h --help -f --filter"
      local i
      local subcmd_start=0
      local seen=""
      for (( i = 1; i < ${#COMP_WORDS[@]}; i++ )); do
        case "$seen,${COMP_WORDS[i]}" in
          ",each")
            seen="each"
            ;;
          "each,--help" | "each,-h")
            ;;
          "each,-f" | "each,--filter")
            seen="--filter"
            ;;
          "--filter,=")
            seen="--filter="
            ;;
          "--filter,"* | "--filter=,"*)
            seen="each"
            ;;
          "each,"*)
            subcmd_start=$i
            break
            ;;
        esac
      done
      if [[ $subcmd_start -ge ${#COMP_WORDS[@]} ]]; then
        COMPREPLY=( $(compgen -c -- "$cur") $(compgen -W "$opts" -- "$cur") )
      elif declare -f _command_offset > /dev/null; then
        _command_offset $subcmd_start
      else
        COMPREPLY=( $(compgen -c -- "$cur") )
      fi
      ;;

    prune)
      local opts="-h --help --dry-run"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
      ;;

    push)
      local opts="-h --help -f --force -r --remote -u --upstream"
      case "$prev" in
        -r | --remote)
          COMPREPLY=( $(_feature_compgen_remotes "$cur" "$git_dir" "$work_tree") )
          ;;
        -u | --upstream)
          COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          ;;
      esac
      ;;

    show)
      local opts="-h --help -S --no-summary -P --no-patch -m --message --paging"
      case "$prev" in
        -m | --message)
          COMPREPLY=( $(compgen -W "none subject full" -- "$cur") )
          ;;
        --paging)
          COMPREPLY=( $(compgen -W "auto always never" -- "$cur") )
          ;;
        -S | --no-summary | -P | --no-patch)
          COMPREPLY=( $(compgen -W "true false" -- "${cur#=}") )
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") $(_feature_compgen_revisions "$cur" "$git_dir" "$work_tree") )
          ;;
      esac
      ;;

    start)
      local opts="-h --help --dry-run --sep --format --fmt --from -s --stay"
      case "$prev" in
        --from)
          COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
          ;;
      esac
      ;;

    status)
      local opts="-h --help -U --no-untracked -P --no-projects -M --no-modules"
      case "$prev" in
        -U | --no-untracked | -P | --no-projects | -M | --no-modules)
          COMPREPLY=( $(compgen -W "true false" -- "${cur#=}") )
          ;;
      esac
      COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
      ;;

    sync)
      local opts="-h --help --dry-run -F --no-fetch --no-prune --no-projects \
        -M --no-modules"
      case "$prev" in
        -F | --no-fetch | --no-prune | --no-projects | -M | --no-modules)
          COMPREPLY=( $(compgen -W "true false" -- "${cur#=}") )
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
          ;;
      esac
      ;;

    tag)
      local opts="-h --help --at -r --remote --push -m --message"
      case "$prev" in
        --at)
          COMPREPLY=( $(_feature_compgen_revisions "$cur" "$git_dir" "$work_tree"))
          ;;
        -r | --remote)
          COMPREPLY=( $(_feature_compgen_remotes "$cur" "$git_dir" "$work_tree"))
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
          ;;
      esac
      ;;

    tags)
      local opts="-h --help -P --no-projects -M --no-modules"
      case "$prev" in
        -P | --no-projects | -M | --no-modules)
          COMPREPLY=( $(compgen -W "true false" -- "${cur#=}") )
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") $(_feature_compgen_tags "$cur" "$git_dir" "$work_tree") )
          ;;
      esac
      ;;

    update)
      local opts="-h --help --dry-run -c --continue -a --abort"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur") $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
      ;;

    version_log)
      local opts="-h --help"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur") $(_feature_compgen_revisions "$cur" "$git_dir" "$work_tree") )
      ;;

    wip)
      local opts="-h --help drop list pop push show"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
      ;;

    wip_drop | wip_show)
      local opts="-h --help"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur") $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
      ;;

    wip_list)
      local opts="-h --help -a --all"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur") $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
      ;;

    wip_pop)
      local opts="-h --help -k --keep"
      COMPREPLY=( $(compgen -W "$opts" -- "$cur") $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree") )
      ;;

    wip_push)
      local opts="-h --help -s --staged -u --untracked -k --keep -b --branch"
      case "$prev" in
        -b | --branch)
          COMPREPLY=( $(_feature_compgen_branches "$cur" "$git_dir" "$work_tree"))
          ;;
        *)
          COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
      esac
      ;;
  esac
}

complete -F _feature -o nosort -o bashdefault -o default feature
