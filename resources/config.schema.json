{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "branch": {
      "description": "Branch name options",
      "$ref": "#/$defs/BranchConfig",
      "default": {
        "sep": "-"
      }
    },
    "default_remote": {
      "description": "Name of the remote to use when one can't be determined automatically",
      "type": "string",
      "default": "origin"
    },
    "projects": {
      "description": "Stores list of subprojects",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProjectEntry"
      },
      "default": {}
    },
    "protect": {
      "description": "List of branches to protect from force-pushes/deletion",
      "type": "array",
      "default": [
        "main"
      ],
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "BranchConfig": {
      "type": "object",
      "properties": {
        "sep": {
          "description": "Separator used between words in branch names",
          "type": "string",
          "default": "-"
        },
        "template": {
          "description": "Template for creating branch names. See `feature start --help` for more\ninfo",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ProjectEntry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "path"
      ]
    }
  }
}
